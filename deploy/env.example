# Environment variables for docker compose. Copy the ones you need into the root .env
# (ignored by Git); docker compose reads it automatically.

# --- Claude (advisor service) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-sonnet-5.
CLAUDE_MODEL=

# --- Shared secret between the gateway and the services ---
INTERNAL_TOKEN=change-me

# --- Gateway ---
# Generate with: echo "base64:$(head -c 32 /dev/urandom | base64)"
GATEWAY_APP_KEY=
# Admin account, seeded only when it does not exist yet.
ADMIN_EMAIL=admin@saludinteligente.lat
ADMIN_PASSWORD=change-me
FRONTEND_ORIGINS=https://saludinteligente.lat,https://www.saludinteligente.lat

# --- Business contact channels (leave empty until confirmed; nothing is invented) ---
# WhatsApp in international format, digits only, e.g. 57 followed by the number.
BUSINESS_WHATSAPP=
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_ADDRESS=
BUSINESS_CITY=
BUSINESS_HOURS=
BUSINESS_INSTAGRAM=
BUSINESS_FACEBOOK=

# --- Database ---
POSTGRES_PASSWORD=salud
